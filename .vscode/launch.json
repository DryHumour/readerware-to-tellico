{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Books",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "args": [
                "books",
                "--log-level=warn",
                "--input-file=/home/nschelle/exports/Books/export.csv",
                "--output-file=/home/nschelle/exports/Books/books.tc",
                "--extracted-images-dir=/home/nschelle/exports/Books"
            ],
            "showLog": true
        },
        {
            "name": "Launch Music",
