{{- /* Static header for Tellico Books collection */ -}}
{{- define "books.header" -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tellico PUBLIC '-//Robby Stephenson/DTD Tellico V11.0//EN' 'http://periapsis.org/tellico/dtd/v11/tellico.dtd'>
<tellico xmlns="http://periapsis.org/tellico/" syntaxVersion="11">
 <collection title="My Books" type="2">
  <fields>
   <!-- Tellico "books" fields -->
   <field category="General" flags="8" format="1" name="title" title="Title" type="1"/>
   <field category="General" flags="0" format="1" name="subtitle" title="Subtitle" type="1"/>
   <field category="General" flags="7" format="2" name="author" title="Author" type="1"/>
   <field category="General" flags="7" format="2" name="editor" title="Editor" type="1"/>
   <field allowed="Hardcover;Paperback;Trade Paperback;Mass Market Paperback;Comb Bound;Spiral Bound;Saddle-Stitched;Side-Stitched;Audio CD" category="General" flags="2" format="4" name="binding" title="Binding" type="3"/>
   <field category="General" flags="0" format="3" name="pur_date" title="Purchase Date" type="1"/>
   <field category="General" flags="0" format="4" name="pur_price" title="Purchase Price" type="1"/>
   <field category="Publishing" flags="6" format="0" name="publisher" title="Publisher" type="1"/>
   <field category="Publishing" flags="4" format="0" name="edition" title="Edition" type="1"/>
   <field category="Publishing" flags="3" format="4" name="cr_year" title="Copyright Year" type="6"/>
   <field category="Publishing" flags="2" format="4" name="pub_year" title="Publication Year" type="6"/>
   <field category="Publishing" description="International Standard Book Number" flags="0" format="4" name="isbn" title="ISBN#" type="1"/>
   <field category="Publishing" description="Library of Congress Control Number" flags="0" format="4" name="lccn" title="LCCN#" type="1"/>
   <field category="Publishing" flags="0" format="4" name="pages" title="Pages" type="6"/>
   <field category="General" flags="7" format="2" name="translator" title="Translator" type="1"/>
   <field category="Publishing" flags="7" format="4" name="language" title="Language" type="1"/>
   <field category="Classification" flags="7" format="4" name="genre" title="Genre" type="1"/>
   <field category="Classification" flags="7" format="4" name="keyword" title="Keywords" type="1"/>
   <field category="Classification" flags="6" format="4" name="series" title="Series" type="1"/>
   <field category="Classification" flags="0" format="4" name="series_num" title="Series Number" type="6"/>
   <field allowed="New;Fine;Near Fine;Very Good;Good;Fair;Poor" category="Personal" flags="0" format="4" name="condition" title="Condition" type="3"/>
   <field category="Personal" flags="0" format="4" name="signed" title="Signed" type="4"/>
   <field category="Personal" flags="0" format="4" name="read" title="Read" type="4"/>
   <field category="Personal" flags="0" format="4" name="gift" title="Gift" type="4"/>
   <field category="Personal" flags="0" format="4" name="loaned" title="Loaned" type="4"/>
   <field category="Personal" flags="2" format="4" name="rating" title="Rating" type="14">
    <prop name="maximum">5</prop>
    <prop name="minimum">1</prop>
   </field>
   <field category="Front Cover" flags="0" format="4" name="cover" title="Front Cover" type="10"/>
   <field category="Plot Summary" flags="0" format="4" name="plot" title="Plot Summary" type="2"/>
   <field category="Comments" flags="0" format="4" name="comments" title="Comments" type="2"/>
   <field category="Personal" flags="32" format="4" name="id" title="ID" type="6">
    <prop name="template">%{@id}</prop>
   </field>
   <field category="Personal" flags="16" format="3" name="cdate" title="Date Created" type="12"/>
   <field category="Personal" flags="16" format="3" name="mdate" title="Date Modified" type="12"/>
   <!-- Tellico "special" fields for Readerware Books -->
   <field category="General" flags="1" format="1" name="alttitle" title="Alternate Title" type="1"/>
   <!-- Custom fields for Readerware Books -->
   <field category="General" flags="7" format="2" name="illustrator" title="Illustrator" type="1"/>
   <field category="Publishing" flags="5" format="0" name="pub_place" title="Publication Place" type="1"/>
   <field category="Publishing" flags="0" format="3" name="rel_date" title="Release Date" type="12"/>
   <field category="Publishing" flags="0" format="0" name="dimensions" title="Dimensions" type="1"/>
   <field category="Classification" flags="0" format="0" name="reading_level" title="Reading Level" type="1"/>
   <field category="Classification" flags="0" format="0" name="lexile_level" title="Lexile Level" type="1"/>
   <field category="Personal" flags="0" format="4" name="copies" title="Copies" type="6"/>
   <field category="Publishing" flags="0" format="4" name="barcode" title="Barcode" type="1"/>
   <field category="Publishing" flags="0" format="4" name="issn" title="ISSN#" type="1"/>
   <field category="Classification" flags="0" format="0" name="dewey" title="Dewey" type="1"/>
   <field allowed="New;Fine;Near Fine;Very Good;Good;Fair;Poor" category="Personal" flags="0" format="4" name="cover_condition" title="Cover Condition" type="3"/>
   <field category="Classification" flags="1" format="4" name="rw_category" title="Readerware Categories" type="1"/>
   <field allowed="Library;Study;Basement;Craft;Guest;Master;Living;Kitchen;Hall;Other;Missing" category="Personal" flags="6" format="4" name="location" title="Location" type="3"/>
   <field category="Personal" description="Readerware SOURCE (of Internet update)" flags="0" format="4" name="rw_source" title="Readerware Source" type="1"/>
   <field category="Publishing" flags="0" format="4" name="list_price" title="List Price" type="1"/>
   <field category="Personal" flags="0" format="4" name="item_value" title="Item Value" type="1"/>
   <field category="Personal" flags="0" format="3" name="val_date" title="Valuation Date" type="12"/>
   <field category="Publishing" flags="0" format="4" name="out_of_print" title="Out of Print" type="4"/>
   <field category="Publishing" flags="0" format="4" name="asin" title="ASIN" type="1"/>
   <field category="Publishing" flags="0" format="4" name="volumes" title="Volumes" type="6"/>
   <field category="Publishing" flags="0" format="4" name="media_url" title="Media URL" type="7"/>
   <field category="Classification" flags="0" format="4" name="call_number" title="Call Number" type="1"/>
   <field category="Personal" flags="0" format="4" name="favorite" title="Favorite" type="4"/>
   <field category="Audit" description="Readerware INVENTORY (number found during last physical inventory)" flags="0" format="4" name="inventory" title="Inventory" type="1"/>
   <field category="Publishing" flags="0" format="4" name="weight" title="Weight" type="1"/>
   <!-- Readerware image fields -->
   <field category="Readerware Images" description="Readerware Image 1" flags="0" format="4" name="rw_image1" title="Image 1" type="10"/>
   <field category="Readerware Images" description="Readerware Image 2" flags="0" format="4" name="rw_image2" title="Image 2" type="10"/>
   <field category="Readerware Images" description="Readerware Image 3" flags="0" format="4" name="rw_image3" title="Image 3" type="10"/>
   <field category="Readerware Images" description="Readerware Image 4" flags="0" format="4" name="rw_image4" title="Image 4" type="10"/>
   <field category="Readerware Images" description="Readerware Large Image 1" flags="0" format="4" name="rw_large_image1" title="Large image 1" type="10"/>
   <field category="Readerware Images" description="Readerware Large Image 2" flags="0" format="4" name="rw_large_image2" title="Large image 2" type="10"/>
   <field category="Readerware Images" description="Readerware Large Image 3" flags="0" format="4" name="rw_large_image3" title="Large image 3" type="10"/>
   <field category="Readerware Images" description="Readerware Large Image 4" flags="0" format="4" name="rw_large_image4" title="Large image 4" type="10"/>
   <!-- Computed fields -->
   <field category="General" flags="5" format="2" name="credit" title="Credit" type="1"/>
   <field category="Audit" flags="0" format="4" name="rw_requires_audit" title="Requires Audit" type="4"/>
   <field category="Audit" flags="3" format="4" name="rw_audit_reason" title="Audit Reasons" type="1"/>
  </fields>
{{- end -}}
